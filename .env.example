# ============================================================
# EcoRide - Variables d'environnement
# Copier ce fichier en .env pour le développement local
# Pour Fly.io, utiliser : fly secrets set NOM=valeur
# ============================================================

# --- MySQL (local: container "db" | prod: TiDB Cloud) ---
# Local :
DB_HOST=db
DB_PORT=3306
DB_NAME=ecoride
DB_USER=ecouser
DB_PASS=ecopass
DB_SSL=false

# Production TiDB Cloud :
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=ECORIDE
# DB_USER=2zLxdFJ5Ts4jMaB.root
# DB_PASS=ton_password
# DB_SSL=true

# --- MongoDB (local: container "mongodb" | prod: MongoDB Atlas) ---
# Local :
MONGO_HOST=mongodb
# Production Atlas (remplacer DB_USER:DB_PASS@cluster) :
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecoride_stats

# --- Application ---
BASE_URL=http://localhost:8080
APP_ENV=development

# --- Email ---
CONTACT_EMAIL=contact@ecoride.fr

# --- Session ---
SESSION_LIFETIME=3600

# --- MySQL root (docker-compose uniquement) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecoride
MYSQL_USER=ecouser
MYSQL_PASSWORD=ecopass
