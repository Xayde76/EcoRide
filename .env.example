# ============================================================
# EcoRide - Variables d'environnement
# Copier ce fichier en .env pour le développement local
# Sur Railway, renseigner ces variables dans le dashboard
# ============================================================

# --- MySQL ---
# Local (Docker) :
DB_HOST=db
DB_PORT=3306
DB_NAME=ecoride
DB_USER=ecouser
DB_PASS=ecopass
DB_SSL=false

# Railway MySQL plugin (valeurs injectées automatiquement, adapter si besoin) :
# DB_HOST=containers-us-west-xxx.railway.app
# DB_PORT=6543
# DB_NAME=railway
# DB_USER=root
# DB_PASS=xxxxxxxxxxxx
# DB_SSL=false

# --- MongoDB ---
# Local (Docker) :
MONGO_HOST=mongodb
# Production MongoDB Atlas :
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecoride_stats

# --- Application ---
BASE_URL=http://localhost:8080
# Railway :
# BASE_URL=https://ecoride-production-2313.up.railway.app
APP_ENV=development

# --- Email (Gmail SMTP) ---
CONTACT_EMAIL=contact@ecoride.fr
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=ton.email@gmail.com

# --- Session ---
SESSION_LIFETIME=3600

# --- MySQL root (docker-compose local uniquement) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecoride
MYSQL_USER=ecouser
MYSQL_PASSWORD=ecopass
